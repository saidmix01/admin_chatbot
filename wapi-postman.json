{
  "info": {
    "name": "Wapi Admin API",
    "description": "Colección completa de endpoints para integrar el Bot Service con el Admin de Wapi.\n\n## Endpoints del Bot\nEstos endpoints son **públicos** — el bot service los llama sin autenticación.\n\n## Endpoints del Admin\nEndpoints **protegidos por sesión** (cookie ci_session). Requieren login previo en el panel.\n\n## Variables\n- `base_url`: URL base del admin\n- `us_id`: ID del usuario/negocio en el sistema",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🤖 Bot Service (públicos)",
      "description": "Endpoints que el bot service llama para operar. No requieren sesión.",
      "item": [
        {
          "name": "Login del bot",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"email\": \"admin@ejemplo.com\",\n    \"password\": \"mi-clave\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/login", "path": ["BotApi", "login"]}
          },
          "response": [{"name": "Login exitoso", "code": 200, "body": "{\"status\":true,\"data\":{\"us_id\":2,\"us_name\":\"Juan Pérez\",\"us_email\":\"admin@ejemplo.com\",\"store\":{\"sto_id\":1,\"sto_name\":\"Mi Tienda\",\"sto_phone\":\"573001234567\",\"sto_wellcome_message\":\"¡Bienvenido!\"}}}"}, {"name": "Credenciales inválidas", "code": 401, "body": "{\"status\":false,\"message\":\"Credenciales inválidas\"}"}]
        },
        {
          "name": "Obtener info de tienda",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"sto_id\": 1\n}"},
            "url": {"raw": "{{base_url}}/Api/get_store_information", "path": ["Api", "get_store_information"]}
          },
          "response": [{"name": "Tienda encontrada", "code": 200, "body": "{\"status\":true,\"data\":[{\"sto_id\":1,\"sto_name\":\"Café Colombia\",\"sto_email\":\"cafe@ejemplo.com\",\"sto_direction\":\"Calle 10 #20-30\",\"sto_phone\":\"573001112233\",\"sto_wellcome_message\":\"¡Bienvenido!\"}]}"}]
        },
        {
          "name": "Obtener preguntas del bot",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"chq_parent\": null\n}"},
            "url": {"raw": "{{base_url}}/Api/get_questions", "path": ["Api", "get_questions"]}
          },
          "response": [{"name": "Preguntas encontradas", "code": 200, "body": "{\"status\":true,\"data\":[{\"chq_id\":1,\"chq_text\":\"¿Qué deseas hoy?\",\"chq_type\":2,\"chq_order\":1,\"chq_lists\":null,\"chq_parent\":null,\"options\":[{\"opt_id\":1,\"opt_description\":\"Ver menú\",\"opt_price\":null}]}]}"}]
        },
        {
          "name": "Obtener opciones de una lista",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"lis_id\": 1\n}"},
            "url": {"raw": "{{base_url}}/Api/get_options_by_list", "path": ["Api", "get_options_by_list"]}
          },
          "response": [{"name": "Opciones encontradas", "code": 200, "body": "{\"status\":true,\"data\":[{\"opt_id\":1,\"opt_description\":\"Café Colombiano\",\"opt_price\":15000,\"opt_qty\":10,\"opt_more_information\":\"Café de origen 250g\"}]}"}]
        },
        {
          "name": "Guardar estadística",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"st_information\": {\"type\":\"interaction\",\"question_id\":1,\"answer\":\"ver_menu\"},\n    \"st_status\": 1,\n    \"st_log\": [\"2026-05-12 22:30:01 - usuario eligió ver menú\"],\n    \"st_create_date\": \"2026-05-12\"\n}"},
            "url": {"raw": "{{base_url}}/Api/save_statistics", "path": ["Api", "save_statistics"]}
          },
          "response": [{"name": "Estadística guardada", "code": 200, "body": "{\"status\":true,\"data\":[]}"}]
        },
        {
          "name": "Actualizar estadística",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"st_id\": 1,\n    \"st_information\": {\"type\":\"completed_order\"},\n    \"st_status\": 2\n}"},
            "url": {"raw": "{{base_url}}/Api/update_statistics", "path": ["Api", "update_statistics"]}
          },
          "response": [{"name": "Estadística actualizada", "code": 200, "body": "{\"status\":true}"}]
        }
      ]
    },
    {
      "name": "🔌 Bot Service (BotApi)",
      "description": "Endpoints del controlador BotApi. El bot service los usa para QR, estado, pedidos y mensajes.",
      "item": [
        {
          "name": "Enviar QR",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"qr_base64\": \"iVBORw0KGgoAAAANSUhEUgA...\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/update_qr", "path": ["BotApi", "update_qr"]}
          },
          "response": [{"name": "QR actualizado", "code": 200, "body": "{\"status\":true,\"message\":\"QR actualizado\"}"}]
        },
        {
          "name": "Reportar estado conexión",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"status\": \"connected\",\n    \"whatsapp_number\": \"573001234567\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/update_status", "path": ["BotApi", "update_status"]}
          },
          "response": [{"name": "Estado actualizado", "code": 200, "body": "{\"status\":true,\"message\":\"Estado actualizado\"}"}]
        },
        {
          "name": "Registrar pedido",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"customer_name\": \"María Pérez\",\n    \"customer_phone\": \"573001234567\",\n    \"product_name\": \"Café Colombiano\",\n    \"quantity\": 2,\n    \"message\": \"Quiero 2 libras de café\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/new_order", "path": ["BotApi", "new_order"]}
          },
          "response": [{"name": "Pedido registrado", "code": 200, "body": "{\"status\":true,\"message\":\"Pedido registrado\"}"}]
        },
        {
          "name": "Registrar mensaje de chat",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"us_id\": 2,\n    \"from\": \"customer\",\n    \"customer_phone\": \"573001234567\",\n    \"customer_name\": \"María Pérez\",\n    \"message\": \"Hola, ¿tienen café molido?\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/log_message", "path": ["BotApi", "log_message"]}
          },
          "response": [{"name": "Mensaje registrado", "code": 200, "body": "{\"status\":true,\"message\":\"Mensaje registrado\"}"}]
        },
        {
          "name": "Actualizar estado del pedido",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n    \"bo_id\": 1,\n    \"status\": \"completado\"\n}"},
            "url": {"raw": "{{base_url}}/BotApi/update_order_status", "path": ["BotApi", "update_order_status"]}
          },
          "response": [{"name": "Estado actualizado", "code": 200, "body": "{\"status\":true,\"message\":\"Estado del pedido actualizado\"}"}]
        },
        {
          "name": "Obtener config del bot",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_bot_config/{{us_id}}", "path": ["BotApi", "get_bot_config", "{{us_id}}"]}},
          "response": [{"name": "Config obtenida", "code": 200, "body": "{\"status\":true,\"data\":{\"business_name\":\"Café Colombia\",\"welcome_msg\":\"¡Bienvenido!\",\"menu_msg\":\"Elige una opción:\",\"offhours_msg\":\"Fuera de horario...\",\"goodbye_msg\":\"¡Gracias!\",\"whatsapp_number\":\"573001234567\",\"bot_status\":\"connected\"}}"}]
        },
        {
          "name": "Obtener productos",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_products/{{us_id}}", "path": ["BotApi", "get_products", "{{us_id}}"]}},
          "response": [{"name": "Productos encontrados", "code": 200, "body": "{\"status\":true,\"data\":[{\"ser_id\":1,\"ser_name\":\"Café Colombiano\",\"ser_price\":15000,\"ser_description\":\"Café de origen\",\"ser_type\":\"producto\"}]}"}]
        },
        {
          "name": "Obtener info del negocio",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_business/{{us_id}}", "path": ["BotApi", "get_business", "{{us_id}}"]}},
          "response": [{"name": "Negocio encontrado", "code": 200, "body": "{\"status\":true,\"data\":{\"sto_id\":1,\"sto_name\":\"Café Colombia\",\"sto_phone\":\"573001112233\",\"sto_direction\":\"Calle 10 #20-30\"}}"}]
        }
      ]
    },
    {
      "name": "🔐 Admin (requieren sesión)",
      "description": "Endpoints que el panel admin consume. Requieren cookie de sesión de CodeIgniter.",
      "item": [
        {
          "name": "Obtener QR del bot",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_qr/{{us_id}}", "path": ["BotApi", "get_qr", "{{us_id}}"]}},
          "response": [{"name": "QR disponible", "code": 200, "body": "{\"status\":true,\"qr\":\"iVBORw0KGgo...\",\"status_text\":\"waiting_scan\"}"}, {"name": "Sin sesión", "code": 200, "body": "{\"status\":false,\"qr\":null,\"status_text\":\"no_session\"}"}]
        },
        {
          "name": "Obtener estado completo",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_status/{{us_id}}", "path": ["BotApi", "get_status", "{{us_id}}"]}},
          "response": [{"name": "Estado completo", "code": 200, "body": "{\"status\":true,\"data\":{\"bs_id\":1,\"us_id\":2,\"bs_status\":\"connected\",\"bs_whatsapp_number\":\"573001234567\",\"bs_last_activity\":\"2026-05-12 22:30:00\"}}"}]
        },
        {
          "name": "Refrescar QR",
          "request": {"method": "POST", "url": {"raw": "{{base_url}}/BotApi/refresh_qr/{{us_id}}", "path": ["BotApi", "refresh_qr", "{{us_id}}"]}},
          "response": [{"name": "QR reseteado", "code": 200, "body": "{\"status\":true,\"message\":\"QR reset. El bot generará uno nuevo.\"}"}]
        },
        {
          "name": "Obtener pedidos",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_orders/{{us_id}}", "path": ["BotApi", "get_orders", "{{us_id}}"]}},
          "response": [{"name": "Lista de pedidos", "code": 200, "body": "{\"status\":true,\"data\":[{\"bo_id\":1,\"us_id\":2,\"bo_customer_name\":\"María Pérez\",\"bo_customer_phone\":\"573001234567\",\"bo_product_name\":\"Café Colombiano\",\"bo_quantity\":2,\"bo_status\":\"nuevo\",\"created_at\":\"2026-05-12 22:35:00\"}]}"}]
        },
        {
          "name": "Obtener mensajes",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/BotApi/get_messages/{{us_id}}", "path": ["BotApi", "get_messages", "{{us_id}}"]}},
          "response": [{"name": "Lista de mensajes", "code": 200, "body": "{\"status\":true,\"data\":[{\"bm_id\":1,\"us_id\":2,\"bm_from\":\"customer\",\"bm_customer_phone\":\"573001234567\",\"bm_customer_name\":\"María Pérez\",\"bm_message\":\"Hola ¿tienen café molido?\",\"created_at\":\"2026-05-12 22:34:00\"}]}"}]
        }
      ]
    },
    {
      "name": "📋 Administración (CRUD)",
      "description": "Endpoints de gestión del panel admin.",
      "item": [
        {
          "name": "Login (panel)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [{"key": "us_email", "value": "admin@ejemplo.com"}, {"key": "us_password", "value": "mi-clave"}]},
            "url": {"raw": "{{base_url}}/Login", "path": ["Login"]}
          }
        },
        {
          "name": "Crear tienda",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [{"key": "sto_name", "value": "Mi Tienda"}, {"key": "sto_email", "value": "tienda@ejemplo.com"}, {"key": "sto_direction", "value": "Calle 10 #20-30"}, {"key": "sto_phone", "value": "573001234567"}]},
            "url": {"raw": "{{base_url}}/Stores/save", "path": ["Stores", "save"]}
          }
        },
        {
          "name": "Guardar preguntas",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"chq_text\":\"¿Qué deseas ordenar?\",\"chq_type\":1,\"chq_order\":1,\"chq_lists\":1,\"chq_parent\":null}"},
            "url": {"raw": "{{base_url}}/Chat_configuration/save", "path": ["Chat_configuration", "save"]}
          }
        },
        {
          "name": "Listar listas",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/List_manage", "path": ["List_manage"]}}
        },
        {
          "name": "Crear lista",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [{"key": "lis_name", "value": "Productos"}]},
            "url": {"raw": "{{base_url}}/List_manage/save", "path": ["List_manage", "save"]}
          }
        },
        {
          "name": "Agregar opción",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"lis_id\":1,\"opt_description\":\"Café 250g\",\"opt_price\":15000,\"opt_qty\":50,\"opt_order\":1}"},
            "url": {"raw": "{{base_url}}/List_manage/save_option", "path": ["List_manage", "save_option"]}
          }
        },
        {
          "name": "Listar usuarios",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/Users", "path": ["Users"]}}
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [{"key": "us_name", "value": "Juan"}, {"key": "us_email", "value": "juan@ejemplo.com"}, {"key": "us_password", "value": "clave123"}, {"key": "pro_id", "value": "2"}]},
            "url": {"raw": "{{base_url}}/Users/save", "path": ["Users", "save"]}
          }
        },
        {
          "name": "Listar perfiles",
          "request": {"method": "GET", "url": {"raw": "{{base_url}}/Profiles", "path": ["Profiles"]}}
        }
      ]
    }
  ],
  "variable": [
    {"key": "base_url", "value": "https://admin.wapiapp.cloud", "type": "string"},
    {"key": "us_id", "value": "2", "type": "number"}
  ]
}
